generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//
// ==========================
// ✅ ENUMS
// ==========================
// Evita plataforma errada e facilita filtros/queries
//
enum MetricsPlatform {
  instagram
  youtube
}

//
// ==========================
// 👤 USER
// ==========================
//
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  userName     String?  @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // ==========================

  instagramAccounts   InstagramAccount[]
  youtubeAccounts     YouTubeAccount[]
  instagramCandidates InstagramCandidate[] // ✅ pendentes pós OAuth

  // ✅ histórico de métricas (diário)
  metricsSnapshots MetricsSnapshot[]

  // ✅ refresh tokens (sessão do app)
  refreshTokens RefreshToken[]

  // ✅ Posts / backfill
  instagramPosts        InstagramPost[]
  instagramBackfillJobs InstagramBackfillJob[]

  // ✅ histórico followers diário (usado no metrics)
  instagramFollowersDaily InstagramFollowersDaily[]

  @@map("User")
}

//
// ==========================
// 🔐 REFRESH TOKENS (APP AUTH)
// ==========================
//
model RefreshToken {
  id     String @id @default(uuid())
  userId String

  // ✅ armazene SOMENTE o hash (sha256 por exemplo)
  tokenHash String @unique

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  // ==========================

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("RefreshTokens")
}

//
// ==========================
// ✅ INSTAGRAM CANDIDATES (PÓS OAUTH, ANTES DE SELECIONAR)
// ==========================
// Guarda as páginas/contas possíveis que vieram do OAuth.
// O front usa isso para mostrar a lista e o usuário escolher qual conectar.
//
model InstagramCandidate {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ✅ id que o front usa pra selecionar (ex: igsel_xxx)
  selectionId String

  // ✅ IG user id (Graph)
  igUserId String

  // username do IG (quando disponível)
  username String?

  // BUSINESS | CREATOR | etc (quando disponível)
  accountType String?

  // página que “carrega” a conexão
  facebookPageId   String
  facebookPageName String?

  // token da página (necessário para endpoints IG)
  pageAccessToken String

  // de onde veio (instagram_business_account | connected_instagram_account)
  source String

  // ✅ quando confirmar, a gente pode apontar pra conta conectada
  instagramAccountId String?
  instagramAccount   InstagramAccount? @relation(fields: [instagramAccountId], references: [id], onDelete: SetNull)

  // controle
  createdAt  DateTime  @default(now())
  selectedAt DateTime?

  // ✅ importante: evita conflito global de selectionId entre usuários/testes
  @@unique([userId, selectionId], name: "userId_selectionId")
  @@index([userId, createdAt])
  @@index([userId, selectionId, createdAt])
  @@map("InstagramCandidates")
}

//
// ==========================
// 📷 INSTAGRAM ACCOUNT
// ==========================
// ✅ MULTI-CONTA:
// - unique composto (userId, instagramId)
//
model InstagramAccount {
  id String @id @default(uuid())

  // id do usuário IG (Graph)
  instagramId       String
  instagramUserName String?
  accountType       String? // BUSINESS | CREATOR | etc
  facebookPageId    String?

  accessToken          String?
  pageAccessToken      String?
  accessTokenExpiresAt DateTime?
  grantedScopes        String?

  // Controle de renovação
  lastRefreshedAt DateTime?

  // Flag de vínculo ativo
  isConnected Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ==========================

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ✅ Posts pertencem a uma conta específica
  posts InstagramPost[]

  // ✅ Jobs de backfill por conta
  backfillJobs InstagramBackfillJob[]

  // ✅ candidates ligados (opcional)
  candidates InstagramCandidate[]

  @@unique([userId, instagramId], name: "userId_instagramId")
  @@index([userId])
  @@index([instagramId])
  @@map("InstagramAccounts")
}

//
// ==========================
// ▶️ YOUTUBE ACCOUNT
// ==========================
//
model YouTubeAccount {
  id String @id @default(uuid())

  // ==========================
  // Canal
  // ==========================
  channelId     String  @unique
  channelTitle  String?
  channelHandle String?

  // ==========================
  // Tokens OAuth (YouTube)
  // ==========================
  accessToken   String?
  refreshToken  String?
  expiresAt     DateTime?
  grantedScopes String?

  lastRefreshedAt DateTime?

  // Flag de vínculo ativo
  isConnected Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ==========================

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("YouTubeAccounts")
}

//
// ==========================
// 📊 MÉTRICAS HISTÓRICAS (DIÁRIO)
// ==========================
//
model MetricsSnapshot {
  id       String          @id @default(uuid())
  userId   String
  platform MetricsPlatform

  // ✅ só a data (YYYY-MM-DD) no Postgres
  date DateTime @db.Date

  followers         Int   @default(0)
  reach             Int   @default(0)
  totalInteractions Int   @default(0)
  engagementRate    Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ==========================

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform, date], name: "userId_platform_date")
  @@index([userId, platform, date])
  @@map("MetricsSnapshots")
}

//
// ==========================
// ✅ FOLLOWERS DIÁRIO (para série no gráfico)
//
model InstagramFollowersDaily {
  id String @id @default(uuid())

  userId   String
  igUserId String

  day       DateTime @db.Date
  followers Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ==========================

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, igUserId, day], name: "userId_igUserId_day")
  @@index([userId, igUserId, day])
  @@map("InstagramFollowersDaily")
}

//
// ==========================
// ✅ POSTS DO INSTAGRAM (CATÁLOGO)
// ==========================
// - post pertence a UMA InstagramAccount
// - igMediaId unique por (instagramAccountId, igMediaId)
//
model InstagramPost {
  id String @id @default(uuid())

  userId             String
  instagramAccountId String

  // id do post na Graph API
  igMediaId String

  mediaType   String?
  publishedAt DateTime
  caption     String?
  permalink   String?

  likeCount     Int @default(0)
  commentsCount Int @default(0)

  // opcional: thumbs/cache
  thumb String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ==========================

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  metrics InstagramPostMetric[]
  results InstagramPostInsightResult[]

  @@unique([instagramAccountId, igMediaId], name: "instagramAccountId_igMediaId")
  @@index([userId, publishedAt])
  @@index([instagramAccountId, publishedAt])
  @@map("InstagramPosts")
}

//
// ==========================
// ✅ MÉTRICAS DO POST (INSIGHTS)
// ==========================
//
model InstagramPostMetric {
  id       String   @id @default(uuid())
  postId   String
  pulledAt DateTime @default(now())

  reach      Int @default(0)
  likes      Int @default(0)
  comments   Int @default(0)
  shares     Int @default(0)
  saves      Int @default(0)
  plays      Int @default(0)
  videoViews Int @default(0)

  totalInteractions Int @default(0)

  // opcional: guarda payload bruto pra debug
  raw Json?

  // ==========================

  post InstagramPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, pulledAt])
  @@map("InstagramPostMetrics")
}

//
// ==========================
// ✅ RESULTADO DO MOTOR (POS/NEG/ESTÁVEL + JSON)
//
model InstagramPostInsightResult {
  id String @id @default(uuid())

  postId             String
  baselineWindowDays Int

  verdict String // positive | negative | stable
  score   Float?

  evidence Json
  why      Json
  improve  Json
  continue Json

  computedAt DateTime @default(now())

  // ==========================

  post InstagramPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, baselineWindowDays], name: "postId_baselineWindowDays")
  @@index([postId, baselineWindowDays])
  @@map("InstagramPostInsightResults")
}

//
// ==========================
// ✅ JOB DE BACKFILL (FILA NO POSTGRES)
// ==========================
// ✅ AGORA OBRIGATÓRIO: instagramAccountId
// (multi-conta exige isso pra não misturar posts)
//
model InstagramBackfillJob {
  id String @id @default(uuid())

  userId String

  instagramAccountId String

  status String  @default("queued") // queued|running|done|error
  cursor String?

  importedCount  Int @default(0)
  processedCount Int @default(0)

  startedAt  DateTime?
  finishedAt DateTime?
  lastError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ==========================

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@index([instagramAccountId, status, createdAt])
  @@map("InstagramBackfillJobs")
}
