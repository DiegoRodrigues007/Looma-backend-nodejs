generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//
// ==========================
// ✅ ENUMS
// ==========================
// Evita plataforma errada e facilita filtros/queries
//
enum MetricsPlatform {
  instagram
  youtube
}

//
// ==========================
// 👤 USER
// ==========================
//
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  userName     String?  @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // ==========================

  instagramAccounts InstagramAccount[]
  youtubeAccounts   YouTubeAccount[]

  // ✅ histórico de métricas (diário)
  metricsSnapshots MetricsSnapshot[]

  // ✅ refresh tokens (sessão do app)
  refreshTokens RefreshToken[]

  // ✅ NOVO: posts e métricas por post (backfill)
  instagramPosts        InstagramPost[]
  instagramBackfillJobs InstagramBackfillJob[]

  @@map("User")
}

//
// ==========================
// 🔐 REFRESH TOKENS (APP AUTH)
// ==========================
//
model RefreshToken {
  id     String @id @default(uuid())
  userId String

  // ✅ armazene SOMENTE o hash (sha256 por exemplo)
  tokenHash String @unique

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  // ==========================

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("RefreshTokens")
}

//
// ==========================
// 📷 INSTAGRAM ACCOUNT
// ==========================
//
model InstagramAccount {
  id                String  @id @default(uuid())
  instagramId       String  @unique
  instagramUserName String?
  accountType       String?
  facebookPageId    String?

  accessToken          String?
  pageAccessToken      String?
  accessTokenExpiresAt DateTime?
  grantedScopes        String?

  // Controle de renovação
  lastRefreshedAt DateTime?

  // Flag de vínculo ativo
  isConnected Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ==========================

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ✅ NOVO: Jobs de backfill por conta (suporta multi-conta por usuário)
  backfillJobs InstagramBackfillJob[]

  @@index([userId])
  @@map("InstagramAccounts")
}

//
// ==========================
// ▶️ YOUTUBE ACCOUNT
// ==========================
//
model YouTubeAccount {
  id String @id @default(uuid())

  // ==========================
  // Canal
  // ==========================
  channelId     String  @unique
  channelTitle  String?
  channelHandle String?

  // ==========================
  // Tokens OAuth (YouTube)
  // ==========================
  accessToken   String?
  refreshToken  String?
  expiresAt     DateTime?
  grantedScopes String?

  lastRefreshedAt DateTime?

  // Flag de vínculo ativo
  isConnected Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ==========================

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("YouTubeAccounts")
}

//
// ==========================
// 📊 MÉTRICAS HISTÓRICAS (DIÁRIO)
// ==========================
//
model MetricsSnapshot {
  id       String          @id @default(uuid())
  userId   String
  platform MetricsPlatform

  // ✅ só a data (YYYY-MM-DD) no Postgres
  date DateTime @db.Date

  followers         Int   @default(0)
  reach             Int   @default(0)
  totalInteractions Int   @default(0)
  engagementRate    Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ==========================

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform, date], name: "userId_platform_date")
  @@index([userId, platform, date])
  @@map("MetricsSnapshots")
}

//
// ==========================
// ✅ NOVO: POSTS DO INSTAGRAM (CATÁLOGO)
// ==========================
//
model InstagramPost {
  id     String @id @default(uuid())
  userId String

  // id do post na Graph API
  igMediaId String @unique

  mediaType   String?
  publishedAt DateTime
  caption     String?
  permalink   String?

  likeCount     Int @default(0)
  commentsCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ==========================

  user    User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  metrics InstagramPostMetric[]
  results InstagramPostInsightResult[]

  @@index([userId, publishedAt])
  @@map("InstagramPosts")
}

//
// ==========================
// ✅ NOVO: MÉTRICAS DO POST (INSIGHTS)
// ==========================
//
model InstagramPostMetric {
  id       String   @id @default(uuid())
  postId   String
  pulledAt DateTime @default(now())

  reach      Int @default(0)
  likes      Int @default(0)
  comments   Int @default(0)
  shares     Int @default(0)
  saves      Int @default(0)
  plays      Int @default(0)
  videoViews Int @default(0)

  totalInteractions Int @default(0)

  // opcional: guarda payload bruto pra debug
  raw Json?

  // ==========================

  post InstagramPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, pulledAt])
  @@map("InstagramPostMetrics")
}

//
// ==========================
// ✅ NOVO: RESULTADO DO MOTOR (POS/NEG/ESTÁVEL + JSON)
// ==========================
// ✅ AJUSTE IMPORTANTE:
// - permitir múltiplos resultados por post (1 por baselineWindowDays)
// - criar unique composto (postId + baselineWindowDays)
//
model InstagramPostInsightResult {
  id String @id @default(uuid())

  postId             String
  baselineWindowDays Int

  verdict String // positive | negative | stable
  score   Float?

  // tudo em JSON pra evoluir sem migrar toda hora
  evidence Json
  why      Json
  improve  Json
  continue Json

  computedAt DateTime @default(now())

  // ==========================

  post InstagramPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  // ✅ agora sim o upsert por (postId, baselineWindowDays) funciona
  @@unique([postId, baselineWindowDays], name: "postId_baselineWindowDays")
  @@index([postId, baselineWindowDays])
  @@map("InstagramPostInsightResults")
}

//
// ==========================
// ✅ NOVO: JOB DE BACKFILL (FILA NO POSTGRES)
// ==========================
//
model InstagramBackfillJob {
  id String @id @default(uuid())

  userId String

  // ✅ importante: job pode ser por conta específica
  instagramAccountId String?

  status String  @default("queued") // queued|running|done|error
  cursor String?

  importedCount  Int @default(0)
  processedCount Int @default(0)

  startedAt  DateTime?
  finishedAt DateTime?
  lastError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ==========================

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  instagramAccount InstagramAccount? @relation(fields: [instagramAccountId], references: [id], onDelete: SetNull)

  @@index([userId, status, createdAt])
  @@index([instagramAccountId, status, createdAt])
  @@map("InstagramBackfillJobs")
}
