generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//
// ==========================
// ✅ ENUMS
// ==========================
// Evita plataforma errada e facilita filtros/queries
//
enum MetricsPlatform {
  instagram
  youtube
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  userName     String?  @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // ==========================
  // Relations
  // ==========================
  instagramAccounts InstagramAccount[]
  youtubeAccounts   YouTubeAccount[]

  // ✅ histórico de métricas
  metricsSnapshots MetricsSnapshot[]

  // ✅ refresh tokens (sessão do app)
  refreshTokens RefreshToken[]

  @@map("User")
}

//
// ==========================
// 🔐 REFRESH TOKENS (APP AUTH)
// ==========================
// Guarda refresh token do LOGIN do Looma (não confundir com YouTube refreshToken)
// ✅ Armazena hash do token (segurança)
// ✅ Permite revogar (logout/rotacionar)
//
model RefreshToken {
  id     String @id @default(uuid())
  userId String

  // ✅ armazene SOMENTE o hash (sha256 por exemplo)
  tokenHash String @unique

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  // ==========================
  // Relation
  // ==========================
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("RefreshTokens")
}

model InstagramAccount {
  id                String  @id @default(uuid())
  instagramId       String  @unique
  instagramUserName String?
  accountType       String?
  facebookPageId    String?

  accessToken          String?
  pageAccessToken      String?
  accessTokenExpiresAt DateTime?
  grantedScopes        String?

  // Controle de renovação
  lastRefreshedAt DateTime?

  // Flag de vínculo ativo
  isConnected Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ==========================
  // Relation
  // ==========================
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("InstagramAccounts")
}

model YouTubeAccount {
  id String @id @default(uuid())

  // ==========================
  // Canal
  // ==========================
  channelId     String  @unique
  channelTitle  String?
  channelHandle String?

  // ==========================
  // Tokens OAuth (YouTube)
  // ==========================
  accessToken   String?
  refreshToken  String?
  expiresAt     DateTime?
  grantedScopes String?

  lastRefreshedAt DateTime?

  // Flag de vínculo ativo
  isConnected Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ==========================
  // Relation
  // ==========================
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("YouTubeAccounts")
}

//
// ==========================
// 📊 MÉTRICAS HISTÓRICAS
// ==========================
// 1 snapshot por usuário / plataforma / dia
//
// ✅ Ajuste-chave pro híbrido:
// - salvar "date" como DATE (sem hora) pra não quebrar por timezone
//
model MetricsSnapshot {
  id       String          @id @default(uuid())
  userId   String
  platform MetricsPlatform

  // ✅ só a data (YYYY-MM-DD) no Postgres
  date DateTime @db.Date

  followers         Int   @default(0)
  reach             Int   @default(0)
  totalInteractions Int   @default(0)
  engagementRate    Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ==========================
  // Relation
  // ==========================
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform, date], name: "userId_platform_date")
  @@index([userId, platform, date])
  @@map("MetricsSnapshots")
}
