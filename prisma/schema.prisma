generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MetricsPlatform {
  instagram
  youtube
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  userName     String?  @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  activeInstagramAccountId String?

  activeInstagramAccount InstagramAccount? @relation("UserActiveInstagramAccount", fields: [activeInstagramAccountId], references: [id], onDelete: SetNull)

  instagramAccounts   InstagramAccount[]
  youtubeAccounts     YouTubeAccount[]
  instagramCandidates InstagramCandidate[]

  metricsSnapshots MetricsSnapshot[]
  refreshTokens    RefreshToken[]

  instagramPosts        InstagramPost[]
  instagramBackfillJobs InstagramBackfillJob[]

  instagramFollowersDaily InstagramFollowersDaily[]

  @@map("User")
}

model RefreshToken {
  id     String @id @default(uuid())
  userId String

  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("RefreshTokens")
}

model InstagramCandidate {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  selectionId String

  igUserId    String
  username    String?
  accountType String?

  facebookPageId   String
  facebookPageName String?

  pageAccessToken String
  source          String

  instagramAccountId String?
  instagramAccount   InstagramAccount? @relation("CandidateToConnectedAccount", fields: [instagramAccountId], references: [id], onDelete: SetNull)

  createdAt  DateTime  @default(now())
  selectedAt DateTime?

  @@unique([userId, selectionId], name: "userId_selectionId")
  @@index([userId, createdAt])
  @@index([userId, selectionId, createdAt])
  @@map("InstagramCandidates")
}

model InstagramAccount {
  id String @id @default(uuid())

  igUserId    String
  username    String?
  accountType String?

  facebookPageId String?

  accessToken     String?
  pageAccessToken String?
  expiresAt       DateTime?
  grantedScopes   String?

  lastRefreshedAt DateTime?
  isConnected     Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  activeForUsers User[] @relation("UserActiveInstagramAccount")

  posts          InstagramPost[]           @relation("InstagramAccountToPosts")
  backfillJobs   InstagramBackfillJob[]
  candidates     InstagramCandidate[]      @relation("CandidateToConnectedAccount")
  followersDaily InstagramFollowersDaily[] @relation("InstagramAccountToFollowersDaily")

  @@unique([userId, igUserId], name: "userId_igUserId")
  @@index([userId])
  @@index([igUserId])
  @@map("InstagramAccounts")
}

model YouTubeAccount {
  id String @id @default(uuid())

  channelId     String  @unique
  channelTitle  String?
  channelHandle String?

  accessToken   String?
  refreshToken  String?
  expiresAt     DateTime?
  grantedScopes String?

  lastRefreshedAt DateTime?

  isConnected Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("YouTubeAccounts")
}

model MetricsSnapshot {
  id       String          @id @default(uuid())
  userId   String
  platform MetricsPlatform

  date DateTime @db.Date

  followers         Int   @default(0)
  reach             Int   @default(0)
  totalInteractions Int   @default(0)
  engagementRate    Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform, date], name: "userId_platform_date")
  @@index([userId, platform, date])
  @@map("MetricsSnapshots")
}

model InstagramFollowersDaily {
  id String @id @default(uuid())

  userId             String
  instagramAccountId String

  day       DateTime @db.Date
  followers Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  instagramAccount InstagramAccount @relation("InstagramAccountToFollowersDaily", fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@unique([instagramAccountId, day], name: "instagramAccountId_day")
  @@index([userId, instagramAccountId, day])
  @@map("InstagramFollowersDaily")
}

model InstagramPost {
  id String @id @default(uuid())

  userId             String
  instagramAccountId String

  igMediaId String

  mediaType   String?
  publishedAt DateTime
  caption     String?
  permalink   String?

  likeCount     Int @default(0)
  commentsCount Int @default(0)

  thumb String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  instagramAccount InstagramAccount @relation("InstagramAccountToPosts", fields: [instagramAccountId], references: [id], onDelete: Cascade)

  metrics InstagramPostMetric[]
  results InstagramPostInsightResult[]

  @@unique([instagramAccountId, igMediaId], name: "instagramAccountId_igMediaId")
  @@index([userId, publishedAt])
  @@index([instagramAccountId, publishedAt])
  @@map("InstagramPosts")
}

model InstagramPostMetric {
  id       String   @id @default(uuid())
  postId   String
  pulledAt DateTime @default(now())

  reach      Int @default(0)
  likes      Int @default(0)
  comments   Int @default(0)
  shares     Int @default(0)
  saves      Int @default(0)
  plays      Int @default(0)
  videoViews Int @default(0)

  totalInteractions Int @default(0)

  raw Json?

  post InstagramPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, pulledAt])
  @@map("InstagramPostMetrics")
}

model InstagramPostInsightResult {
  id String @id @default(uuid())

  postId             String
  baselineWindowDays Int

  verdict String
  score   Float?

  evidence Json
  why      Json
  improve  Json
  continue Json

  computedAt DateTime @default(now())

  post InstagramPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, baselineWindowDays], name: "postId_baselineWindowDays")
  @@index([postId, baselineWindowDays])
  @@map("InstagramPostInsightResults")
}

model InstagramBackfillJob {
  id String @id @default(uuid())

  userId String

  instagramAccountId String

  status String  @default("queued")
  cursor String?

  importedCount  Int @default(0)
  processedCount Int @default(0)

  startedAt  DateTime?
  finishedAt DateTime?
  lastError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@index([instagramAccountId, status, createdAt])
  @@map("InstagramBackfillJobs")
}
