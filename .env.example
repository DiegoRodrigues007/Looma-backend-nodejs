PORT=7031
FRONTEND_URL="http://localhost:5173"

DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/DBNAME?schema=public"

JWT_SECRET="CHANGE_ME"
JWT_ISSUER="Looma"
JWT_AUDIENCE="LoomaUsers"
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7

CORS_ORIGIN="*"

INSTAGRAM_CLIENT_ID="YOUR_INSTAGRAM_CLIENT_ID"
INSTAGRAM_CLIENT_SECRET="YOUR_INSTAGRAM_CLIENT_SECRET"
INSTAGRAM_REDIRECT_URI="http://localhost:7031/api/instagram/callback"
INSTAGRAM_SCOPES="public_profile,email,pages_show_list,pages_read_engagement,pages_read_user_content,instagram_basic,instagram_manage_insights"
INSTAGRAM_AUTH_URL="https://www.facebook.com/v21.0/dialog/oauth"
INSTAGRAM_TOKEN_URL="https://graph.facebook.com/v21.0/oauth/access_token"
INSTAGRAM_GRAPH_BASE_URL="https://graph.facebook.com/v21.0"

YOUTUBE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
YOUTUBE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
YOUTUBE_REDIRECT_URI="http://localhost:7031/api/youtube/callback"
