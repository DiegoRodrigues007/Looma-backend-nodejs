# =========================
# Ambiente
# =========================
NODE_ENV=test

# =========================
# Postgres de teste (docker-compose.test.yml)
# =========================
DATABASE_URL="postgresql://looma_test:looma_test@localhost:55432/looma_test?schema=public"

# =========================
# JWT (PRECISA bater com env.jwt.secret/issuer/audience do seu env.ts)
# Ajuste conforme seu projeto
# =========================
JWT_SECRET="test_secret_123"
JWT_ISSUER="looma-test"
JWT_AUDIENCE="looma-test"

# =========================
# Instagram / Meta (apontar pro fakeMetaServer)
# ⚠️ Ajuste os nomes conforme seu env.ts lê.
# Ex: se seu env.ts usa META_GRAPH_BASE_URL ou IG_GRAPH_BASE_URL, troque aqui.
# =========================

# Caso seu client use algo como GRAPH_BASE_URL:
GRAPH_BASE_URL="http://127.0.0.1:4111"

# Caso use versão no path (como /v21.0), você pode fazer:
# GRAPH_BASE_URL="http://127.0.0.1:4111/v21.0"

# Se o seu env.ts usa outro nome, coloque também:
IG_GRAPH_BASE_URL="http://127.0.0.1:4111"
META_GRAPH_BASE_URL="http://127.0.0.1:4111"

INSTAGRAM_GRAPH_BASE_URL=http://127.0.0.1:4111